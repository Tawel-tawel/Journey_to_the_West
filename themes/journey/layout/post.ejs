<article class="content-page">
  <header class="page-header">
    <p class="eyebrow"><%= page.categories && page.categories.length ? page.categories.map(function(c) { return c.name }).join(' / ') : 'Travel' %></p>
    <h1><%= page.title %></h1>
    <time><%= date(page.date, 'YYYY-MM-DD') %></time>
  </header>
  <div class="markdown-body">
    <%- page.content %>
  </div>
</article>
