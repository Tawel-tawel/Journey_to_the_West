<section class="content-page">
  <header class="page-header">
    <p class="eyebrow">Archives</p>
    <h1>全部文章</h1>
    <% var allItems = []; %>
    <% page.posts.forEach(function(p) { allItems.push({ title: p.title, date: p.date, path: p.path, tags: p.tags }); }); %>
    <% site.pages.forEach(function(p) { if (p.hierarchy && p.hierarchy.length) { allItems.push({ title: p.title, date: p.date, path: p.path, tags: p.tags }); } }); %>
    <% allItems.sort(function(a,b){ return new Date(b.date) - new Date(a.date); }); %>
    <p class="page-desc">共 <%= allItems.length %> 篇</p>
  </header>
  <div class="archive-list">
    <% allItems.forEach(function(item) { %>
      <article class="archive-item">
        <time><%= date(item.date, 'YYYY-MM-DD') %></time>
        <a href="<%- url_for(item.path) %>">
          <h3><%= item.title %></h3>
        </a>
        <% if (item.tags && item.tags.length) { %>
          <div class="archive-tags">
            <% (Array.isArray(item.tags) ? item.tags : []).forEach(function(t) { %>
              <span class="tag"><%= typeof t === 'string' ? t : t.name %></span>
            <% }) %>
          </div>
        <% } %>
      </article>
    <% }) %>
  </div>
</section>
