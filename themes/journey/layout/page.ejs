<article class="content-page">
  <header class="page-header">
    <% if (page.path && page.path.startsWith('travels/') && page.path !== 'travels/index.html') { %>
      <a class="back-link" href="<%- url_for('/travels/') %>">← 返回足迹列表</a>
    <% } %>
    <h1><%= page.title %></h1>
    <% if (page.date) { %>
      <time><%= date(page.date, 'YYYY-MM-DD') %></time>
    <% } %>
  </header>
  <div class="markdown-body">
    <%- page.content %>
  </div>
</article>
